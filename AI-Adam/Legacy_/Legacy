from fastapi import FastAPI, UploadFile, File, HTTPException
import pandas as pd
import chromadb
from chromadb.utils import embedding_functions
from transformers import pipeline
import uuid

app = FastAPI()

# Initialize ChromaDB client
chroma_client = chromadb.Client()

# Initialize Hugging Face's text generation model
generator = pipeline('text-generation', model='distilgpt2', tokenizer='distilgpt2', device=-1)

# Create the embedding function by passing the model name
embedding_function = embedding_functions.SentenceTransformerEmbeddingFunction(model_name="all-MiniLM-L6-v2")

# Create or load a collection in ChromaDB
collection = chroma_client.get_or_create_collection(
    name="csv_data",
    embedding_function=embedding_function
)


@app.post("/upload-csv/")
async def upload_csv(file: UploadFile = File(...)):
    if not file.filename.endswith(".csv"):
        raise HTTPException(status_code=400, detail="Only CSV files are allowed.")

    # Read CSV data into a pandas dataframe
    try:
        df = pd.read_csv(file.file)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Error reading CSV file: {str(e)}")

    # Store CSV data in Chroma VectorDB
    try:
        for index, row in df.iterrows():
            row_data = row.to_dict()
            row_text = " ".join([f"{key}: {value}" for key, value in row_data.items()])

            # Generate unique ID for the document
            document_id = str(uuid.uuid4())

            # Embed the text of the row into a vector using the SentenceTransformerEmbeddingFunction
            # Use `embedding_function.__call__()` instead of `embed_documents()`
            vector = embedding_function([row_text])[0]

            # Add the embedded row to the collection with metadata
            collection.add(
                ids=[document_id],
                embeddings=[vector],
                metadatas=[row_data],
                documents=[row_text]
            )
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error storing data in Chroma: {str(e)}")

    return {"detail": "CSV data uploaded and embedded successfully"}


@app.post("/diagnosis/")
async def diagnosis(query: str):
    # Retrieve similar data from ChromaDB based on the query
    try:
        embedding_query = embedding_function([query])[0]
        results = collection.query(query_embeddings=[embedding_query], n_results=5)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error querying Chroma: {str(e)}")

    if not results['documents']:
        raise HTTPException(status_code=404, detail="No relevant documents found.")

    # Generate text based on the retrieved documents using Hugging Face's pipeline
    try:
        retrieved_text = " ".join(results['documents'])
        generated_text = generator(retrieved_text, max_length=500, num_return_sequences=1)
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error generating text: {str(e)}")

    # Return generated output in paragraph format
    return {"generated_paragraph": generated_text[0]['generated_text']}


@app.get("/display/")
async def display():
    # Display all the vectors and their metadata stored in the ChromaDB collection
    try:
        all_data = collection.get()
        if not all_data['documents']:
            return {"detail": "No data in the collection"}

        detailed_view = []
        for doc, metadata, vector in zip(all_data['documents'], all_data['metadatas'], all_data['embeddings']):
            detailed_view.append({
                "document": doc,
                "metadata": metadata,
                "vector": vector
            })

        return {"data": detailed_view}
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Error fetching data: {str(e)}")


# Ensure to persist data at shutdown
@app.on_event("shutdown")
def shutdown():
    chroma_client.persist()
