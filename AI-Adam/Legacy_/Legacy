def get_diagnosis(user_input, retries=3, delay=5):
    # <thinking>
    thinking = "<thinking>\n"
    thinking += "Analyzing the user input and preparing to call the Hugging Face API...\n"
    thinking += f"User Input: {user_input}\n"

    # Prepare the payload for the API
    payload = {
        "inputs": user_input,
        "options": {
            "wait_for_model": True
        }
    }

    # Chain of thought: Try the request with retries in case of a 503 error
    thinking += "Step 1: Preparing the API request payload and sending the request.\n"

    for attempt in range(retries):
        response = requests.post(api_url, headers=headers, json=payload)

        if response.status_code == 200:
            result = response.json()
            diagnostic_text = result.get('generated_text', 'No diagnostic information available.')
            thinking += f"Step 2: Received response from API: {diagnostic_text}\n"

            # <reflection> section to review the answer
            reflection = "<reflection>\n"
            reflection += "Reviewing the API response for potential issues or oversights.\n"
            if not diagnostic_text or "error" in diagnostic_text.lower():
                reflection += "The response contains an error or is empty, adjusting the conclusion.\n"
                diagnostic_text = "Unable to provide a proper diagnosis at this time. Please try again later."
            else:
                reflection += "The response seems valid and informative.\n"
            reflection += "</reflection>\n"

            # Conclude the thinking section
            thinking += reflection + "</thinking>\n"

            # <output> section with the final answer
            output = f"<output>{diagnostic_text}</output>"
            return output

        elif response.status_code == 503:
            thinking += f"Attempt {attempt + 1}: API responded with 503, retrying after {delay} seconds...\n"
            time.sleep(delay)
        else:
            error_msg = f"Error {response.status_code}: Unable to process the request."
            thinking += f"API request failed with error: {error_msg}\n"
            thinking += "</thinking>\n"
            return f"<output>{error_msg}</output>"

    # If all retries fail
    thinking += "</thinking>\n"
    return "<output>Error 503: Service temporarily unavailable after multiple attempts.</output>"


